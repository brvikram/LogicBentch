{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogicBench",
  "version": "1.0.0",
  "identifier": "org.logicbench.trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogicBench — Virtual Digital Electronics Trainer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
